# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
# Get these from https://app.alpaca.markets
#   1. Switch the account selector to PAPER (top of the dashboard)
#   2. Left nav -> API Keys -> Generate New Key
#   3. The SECRET is shown ONCE. Copy it immediately.
#
# Paper and live keys are separate and not interchangeable. Leave the LIVE
# entries commented out until you actually intend to trade real money.

ALPACA_PAPER_KEY=PK...
ALPACA_PAPER_SECRET=...

# ALPACA_LIVE_KEY=AK...
# ALPACA_LIVE_SECRET=...
